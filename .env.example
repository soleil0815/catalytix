# ------------------------------------------------------------------
# Catalytix – your own settings
# Copy once:  cp .env.example .env   and adjust it here.
# .env is NOT part of the update package and is kept on every
# update. Everything is optional – without an entry the default applies.
# ------------------------------------------------------------------

# Publish the port on this address only (default: all). 127.0.0.1 if the reverse proxy runs directly on
# this machine (not as a container) – then nobody can bypass the proxy. If the proxy
# (e.g. Nginx Proxy Manager) runs as a container: better use a shared Docker network, see README.
#CATALYTIX_BIND=127.0.0.1

# Image built by GitHub instead of building locally – set by "./update.sh --pull"
# (installing a zip package with update.sh switches back and comments these out again)
#CATALYTIX_IMAGE=ghcr.io/soleil0815/catalytix
#CATALYTIX_TAG=2.16.0

# Port on the Docker host (default 9300)
#CATALYTIX_PORT=9300

# Time zone (for the reminder time and timestamps). If it is missing from the image, the
# log says "Time zone TZ=… not found – times in UTC" at start-up.
#TZ=Europe/Berlin

# Key for sessions AND for encrypting 2FA secrets and stored SMTP/AD passwords.
# Without an entry it is created once and stored in ./data/secret_key (recommended).
# Do NOT change it later: with a different key, 2FA sign-ins fail and the passwords
# are unreadable – Catalytix then refuses to start. Only restore a database together
# with its secret_key.
#CATALYTIX_SECRET_KEY=
# Only once, to deliberately accept a changed key
# (afterwards reset 2FA and enter the SMTP/AD passwords again):
#CATALYTIX_ACCEPT_NEW_KEY=1

# User/group the app runs as and that owns ./data. Best a dedicated service user –
# 1000 is usually the first real user on the host.
#PUID=1000
#PGID=1000

# Reverse proxy: detected automatically. By default, proxy headers are only accepted
# from private networks (10.x, 172.16-31.x, 192.168.x, 127.x).
# Recommended: set your proxy's address here (see README, "Recommendations for running on the internet"):
#CATALYTIX_TRUSTED_PROXIES=private
#CATALYTIX_TRUSTED_PROXIES=172.18.0.0/16,192.168.0.11
#CATALYTIX_TRUSTED_PROXIES=none

# Secure cookies: "auto" = automatically with HTTPS (default), "1" = always, "0" = never
#CATALYTIX_SECURE_COOKIES=auto

# Another database instead of SQLite
#DATABASE_URL=mysql+pymysql://catalytix:secret@db/catalytix?charset=utf8mb4

# Log level: INFO (default) or DEBUG
#CATALYTIX_LOGLEVEL=INFO

# Folder for the automatic backups (default: ./data/backups).
# For a NAS: mount the share in docker-compose.override.yml, e.g. /mnt/nas/library:/backup
#CATALYTIX_BACKUP_DIR=/backup

# Link to the source code on the "About" page (e.g. your GitHub repository)
#CATALYTIX_SOURCE_URL=https://github.com/YOUR-NAME/catalytix
